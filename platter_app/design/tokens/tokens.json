{
  "$description": "Platter design tokens v1.0 — Cerulean & Apricot. Import as Figma variables or map to a Tailwind theme.",
  "color": {
    "cerulean": {"900":"#0E1F27","800":"#16303B","700":"#22485A","600":"#1A6480","500":"#227C9D","300":"#7FB3C7","100":"#DCEAF0"},
    "sea":      {"700":"#0A6B62","600":"#12A497","500":"#17C3B2","300":"#7BDDD3","100":"#DCF6F3"},
    "apricot":  {"700":"#7A4E08","600":"#D9A23F","500":"#FFCB77","300":"#FFE0AA","100":"#FFF3DE"},
    "coral":    {"700":"#A8262D","600":"#F04C54","500":"#FE6D73","300":"#FFAAAE","100":"#FFE5E6"},
    "neutral":  {"white":"#FFFFFF","floral":"#FEF9EF","sand":"#F6EBD8"}
  },
  "semantic": {
    "bg":     {"shell":"{color.cerulean.900}","shellRaised":"{color.cerulean.800}","shellHover":"{color.cerulean.700}","surface":"{color.neutral.floral}","surfaceRaised":"{color.neutral.white}","inset":"{color.neutral.sand}"},
    "text":   {"default":"{color.cerulean.900}","dim":"rgba(14,31,39,0.58)","faint":"rgba(14,31,39,0.40)","invert":"{color.neutral.floral}","invertDim":"rgba(254,249,239,0.64)"},
    "border": {"hairline":"rgba(14,31,39,0.08)","default":"rgba(14,31,39,0.14)","strong":"rgba(14,31,39,0.26)","invert":"rgba(254,249,239,0.15)"},
    "accent":  {"$job":"selection, focus, active tool","fill":"{color.apricot.500}","line":"{color.apricot.600}","text":"{color.apricot.700}","wash":"rgba(255,203,119,0.34)","on":"#2A1A02"},
    "info":    {"$job":"structure, links, primary data","fill":"{color.cerulean.500}","line":"{color.cerulean.500}","text":"{color.cerulean.600}","wash":"rgba(34,124,157,0.14)"},
    "success": {"$job":"confirmed, complete, high confidence","fill":"{color.sea.500}","line":"{color.sea.600}","text":"{color.sea.700}","wash":"rgba(23,195,178,0.17)"},
    "danger":  {"$job":"bond, mandatory, overdue, low confidence, destructive","fill":"{color.coral.500}","line":"{color.coral.600}","text":"{color.coral.700}","wash":"rgba(254,109,115,0.13)"},
    "focusRing":"{color.apricot.600}"
  },
  "radius": {"xs":5,"sm":8,"md":12,"lg":16,"xl":22,"pill":999},
  "space":  {"1":4,"2":8,"3":12,"4":16,"5":20,"6":24,"8":32,"10":40,"14":56,"18":72},
  "font": {
    "family": {"display":"Archivo","body":"Inter","data":"JetBrains Mono"},
    "style": {
      "display": {"family":"display","weight":700,"size":46,"lineHeight":0.98,"tracking":-0.035},
      "h1":      {"family":"display","weight":700,"size":30,"lineHeight":1.08,"tracking":-0.03},
      "h2":      {"family":"display","weight":600,"size":22,"lineHeight":1.15,"tracking":-0.022},
      "h3":      {"family":"display","weight":600,"size":17,"lineHeight":1.25,"tracking":-0.018},
      "body":    {"family":"body","weight":400,"size":15,"lineHeight":1.55},
      "bodySm":  {"family":"body","weight":400,"size":13.5,"lineHeight":1.5},
      "label":   {"family":"data","weight":500,"size":9.5,"tracking":0.12,"case":"upper"},
      "data":    {"family":"data","weight":400,"size":13.5,"numeric":"tabular"},
      "dataLg":  {"family":"data","weight":500,"size":16,"numeric":"tabular"},
      "caption": {"family":"data","weight":400,"size":11.5}
    }
  },
  "elevation": {
    "1":"0 1px 2px rgba(14,31,39,0.06)",
    "2":"0 4px 12px -4px rgba(14,31,39,0.16)",
    "3":"0 16px 34px -16px rgba(14,31,39,0.40)",
    "4":"0 28px 60px -24px rgba(14,31,39,0.52)"
  },
  "motion": {"fast":120,"base":180,"slow":240,"easeOut":"cubic-bezier(0.2,0.7,0.3,1)","easeInOut":"cubic-bezier(0.4,0,0.2,1)"},
  "layout": {"tapMin":44,"railWidth":236,"railCollapsed":60,"commandBarHeight":38},
  "rules": [
    "Components reference semantic tokens only. A raw primitive in a component is a bug.",
    "fill is for backgrounds. text is the only value legible as type on floral white.",
    "Apricot means selection. It is never decorative.",
    "All numerics use the data family with tabular figures.",
    "Confidence thresholds are fixed: high >= 0.90, medium >= 0.70, low < 0.70.",
    "Every component defines hover, focus, disabled, loading, empty and error before shipping."
  ]
}
