// Platter — Step 3 schema
// Source of truth for the shape: /docs/STEP1_PLAN.md Part A, plus the
// controlled vocabularies Batch 6 (Settings) depends on. Money is always
// integer cents (BigInt, never float) — see STEP1_PLAN.md "two decisions
// worth flagging."

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Project spine ──────────────────────────────────────────────

enum ProjectStatus {
  draft
  scoping
  bidding
  leveling
  submitted
  awarded
  lost
}

model Project {
  id                String        @id @default(cuid())
  number            String        @unique
  name              String
  address           String?
  lat               Float?
  lng               Float?
  owner             String?
  architectOfRecord String?
  deliveryMethod    String?
  bondPct           Float?
  retainagePct      Float?
  bidBondRequired   Boolean       @default(false)
  pAndPMode         PAndPMode?
  gcContactName     String?
  gcContactEmail    String?
  gcContactPhone    String?
  status            ProjectStatus @default(draft)
  externalIds       Json          @default("{}")
  addressVerifiedAt DateTime?
  archivedAt        DateTime?
  // Awarded-status dashboard card (S-batch #71) — "schedule days meant
  // contract days. This gets pulled from the proposed duration set in the
  // proposal and verified by the prime contract." No proposal-parsing or
  // prime-contract workflow exists yet, so this is a plain editable field
  // for now, set once verified. The clock itself starts at the
  // notice_to_proceed ProjectDate (below), not stored here.
  contractDays      Int?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  dates              ProjectDate[]
  notes              ProjectNote[]
  documents          Document[]
  specSections       SpecSection[]
  bidPackages        BidPackage[]
  addenda            Addendum[]
  rfis               Rfi[]
  communications     Communication[]
  budgetLines        BudgetLine[]
  budgetRevisions    BudgetRevision[]
  projectFlags       ProjectFlag[]
  projectTags        ProjectTag[]
  changeOrders       ChangeOrder[]
  commitments        Commitment[]
  scheduleActivities ScheduleActivity[]
}

enum ProjectDateKind {
  itb_out
  site_walk
  rfi_cutoff
  addenda_cutoff
  submission_due
  award_target
  notice_to_proceed
}

// Project-level change orders (S-batch #71: "Change orders are project
// level"). Feeds the awarded-status dashboard card's change-order days/
// value stats — summed across every change order on the project.
model ChangeOrder {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  description String
  days        Int      @default(0)
  value       BigInt   @default(0)
  createdAt   DateTime @default(now())
}

// Schedule scaffolding (S-batch #63): "build out the databases a bit
// further [start, finish, duration, calendar type, activity id tracking,
// wbs categories, views, etc.] so it can import a p6 xer." Fields cover
// the owner's explicit list; wbsCategory is stored as a plain label per
// activity, not a true hierarchy.
model ScheduleActivity {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activityId   String
  name         String
  wbsCategory  String?
  startAt      DateTime?
  finishAt     DateTime?
  durationDays Int?
  calendarType String?
  pinned       Boolean   @default(false)
  seq          Int       @default(0)
  createdAt    DateTime  @default(now())

  predecessorLinks ScheduleRelationship[] @relation("Successor")
  successorLinks   ScheduleRelationship[] @relation("Predecessor")
}

// "right click list item to select predecessor successor/logic. allow
// fs and ss. break existing relationships in xer import that are not
// that" (S-batch #64) — only Finish-to-Start and Start-to-Start are
// modeled; a P6 export's FF/SF relationships (or any other type) are
// dropped entirely during import rather than approximated.
enum ScheduleRelType {
  FS
  SS
}

model ScheduleRelationship {
  id            String           @id @default(cuid())
  predecessorId String
  predecessor   ScheduleActivity @relation("Predecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successorId   String
  successor     ScheduleActivity @relation("Successor", fields: [successorId], references: [id], onDelete: Cascade)
  type          ScheduleRelType

  @@unique([predecessorId, successorId])
}

// "add a spot for schedule styles in the settings" (S-batch #63) — the
// owner didn't specify what a style configures beyond it existing;
// kept minimal (name + description) as a placeholder to take into
// design, same treatment as #62's Gantt token pass.
model ScheduleStyle {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
}

// "allow line height modification and make it persistent across users"
// (S-batch #64) — a single global row (key "global"), not per-browser
// localStorage like DataTable's column widths, since this one needs to
// actually be shared across users, not just remembered per device.
model ScheduleDisplaySetting {
  id        String @id @default(cuid())
  key       String @unique @default("global")
  rowHeight Int    @default(30)
}

// "it is a new entity part of the subcontracts / commitments tool. Once
// it is awarded and commitment is executed it would show here." (S-batch
// #71) — minimal slice of that future tool: one Commitment per awarded
// BudgetLine, created when the award is marked executed from the Budget
// page. Feeds the awarded-status dashboard card's commitment count.
model Commitment {
  id                String     @id @default(cuid())
  projectId         String
  project           Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  budgetLineId      String     @unique
  budgetLine        BudgetLine @relation(fields: [budgetLineId], references: [id], onDelete: Cascade)
  subcontractorName String
  amount            BigInt
  executedAt        DateTime   @default(now())
  createdAt         DateTime   @default(now())
}

model ProjectDate {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind        ProjectDateKind
  at          DateTime
  isMandatory Boolean         @default(false)
  notes       String?
}

// Red/green/neutral state chosen at creation (S-batch #65) — "display in
// red or green" plus a 3-way color picker on the owner's spec, read as two
// meaningful accent states plus a neutral default for items that aren't
// notably good or bad news.
enum ProjectNoteState {
  neutral
  risk
  resolved
}

model ProjectNote {
  id           String           @id @default(cuid())
  projectId    String
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  body         String
  author       String
  state        ProjectNoteState @default(neutral)
  pinnedAt     DateTime?
  // The date this hot item is actually about (a deadline, an addendum date,
  // etc.) — separate from createdAt, which is just when the note was added.
  associatedAt DateTime?
  createdAt    DateTime         @default(now())
}

// Generic audit trail — every mutation across every entity (D-09).
model AuditEvent {
  id       String   @id @default(cuid())
  entity   String
  entityId String
  field    String
  oldValue String?
  newValue String?
  actor    String
  at       DateTime @default(now())

  @@index([entity, entityId])
}

// ── Documents & parsing (priority #1) ──────────────────────────

enum DocumentKind {
  spec
  drawing
  addendum
  geotech
  itb
  contract
  other
}

enum ParseStatus {
  pending
  running
  needs_review
  confirmed
  failed
}

model Document {
  id           String       @id @default(cuid())
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  filename     String
  storageKey   String
  sharepointId String?
  kind         DocumentKind
  discipline   String?
  sheetNo      String?
  pageCount    Int?
  ocrRequired  Boolean      @default(false)
  parseStatus  ParseStatus  @default(pending)
  createdAt    DateTime     @default(now())

  parseRuns       ParseRun[]
  specSections    SpecSection[]
  extractedFields ExtractedField[]
}

model ParseRun {
  id            String    @id @default(cuid())
  documentId    String
  document      Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  model         String
  promptVersion String
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  tokenCost     Int?
  error         String?

  extractedFields ExtractedField[]
}

enum ExtractedFieldState {
  pending
  confirmed
  corrected
  rejected
}

// The trust layer (D-13/R-06) — every AI-derived value anywhere in the app
// carries confidence + document + page + bbox + confirmation state. Nothing
// parsed is written straight to its target entity; it lands here first.
model ExtractedField {
  id          String              @id @default(cuid())
  entityType  String
  entityId    String
  fieldPath   String
  valueJson   Json
  confidence  Float
  documentId  String?
  document    Document?           @relation(fields: [documentId], references: [id])
  page        Int?
  bbox        Json?
  state       ExtractedFieldState @default(pending)
  confirmedBy String?
  confirmedAt DateTime?
  parseRunId  String?
  parseRun    ParseRun?           @relation(fields: [parseRunId], references: [id])
  createdAt   DateTime            @default(now())

  @@index([entityType, entityId])
}

enum EditSource {
  user
  agent
  agent_confirmed
}

// Groundwork only (S37) — a lightweight, generic marker for who last wrote a
// value that's already live on its entity, separate from ExtractedField's
// staged/pending trust layer above. No agent writes to app data yet, so
// nothing populates this table today; it exists so the first AI-driven write
// path doesn't also have to invent the provenance model. Full confirmation
// UI/workflow tracked separately (GH issue #39).
model FieldEdit {
  id          String     @id @default(cuid())
  entityType  String
  entityId    String
  fieldPath   String
  source      EditSource
  agentName   String?
  setAt       DateTime   @default(now())
  confirmedBy String?
  confirmedAt DateTime?

  @@index([entityType, entityId])
}

model SpecSection {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  csiCode    String
  title      String
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id])
  pageFrom   Int?
  pageTo     Int?

  scopeLineItems ScopeLineItem[]
}

// ── Scope & packages ────────────────────────────────────────────

// Bonding (E-owner rework, S19): a bid bond is either required or not — the
// percentage is fixed at 100% whenever it applies (see Project.bondPct) — and
// separately, payment & performance bonding is either carried in the base
// bid or priced as an alternate. Both are project-wide by default; a package
// can override requiresBond directly and pAndPMode via its own nullable
// field (null = inherit the project's).
enum PAndPMode {
  in_base
  alternate
}

model BidPackage {
  id                       String           @id @default(cuid())
  projectId                String
  project                  Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code                     String
  name                     String
  csiCodes                 String[]
  status                   String           @default("draft")
  dueAt                    DateTime?
  budgetAmount             BigInt?
  requiresBond             Boolean          @default(false)
  pAndPMode                PAndPMode?
  longLead                 Boolean          @default(false)
  // GC self-performs this scope instead of bidding it out — a distinct
  // package state, not a point on the bid-status spectrum (S-batch #69).
  selfPerform              Boolean          @default(false)
  templateId               String?
  template                 PackageTemplate? @relation(fields: [templateId], references: [id])
  // Which sub's P&P bond alternate got accepted into the award, tracked
  // explicitly at tab reconciliation time — set via the Bid Tab, not editable
  // elsewhere. Null while unresolved even if requiresBond is true.
  bondAcceptedInvitationId String?
  bondAcceptedInvitation   Invitation?      @relation("BondAlternateAccepted", fields: [bondAcceptedInvitationId], references: [id])

  scopeLineItems ScopeLineItem[]
  invitations    Invitation[]
  budgetLines    BudgetLine[]

  @@unique([projectId, code])
}

// "Save as template" (S-batch #72) — captures a project's bid package
// structure and bidder list only, explicitly not cost data, project info,
// or scope line items, for reuse setting up future manual (non-parsed)
// projects. Distinct from the pre-existing, unused PackageTemplate model
// (a single reusable package definition, never wired to any UI) — this is
// a whole-project snapshot of multiple packages at once.
model ProjectTemplate {
  id            String            @id @default(cuid())
  name          String
  description   String?
  sourceProject String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  packages      TemplatePackage[]
}

model TemplatePackage {
  id         String          @id @default(cuid())
  templateId String
  template   ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  code       String
  name       String
  csiCodes   String[]
  // [{ subcontractorId: string | null, name: string }] — denormalized name
  // so the template still means something if a subcontractor is later
  // deleted; subcontractorId is a best-effort link for re-inviting exactly
  // that sub when a template gets applied.
  bidders    Json            @default("[]")
}

enum ScopeLineKind {
  inclusion
  exclusion
  alternate
  allowance
  unit_price
  clarification
  va_option
}

// The atom (STEP1_PLAN.md Part A) — every sub's price attaches to this
// shared line id, which is what makes bid leveling stop being a manual
// mapping exercise: gaps are lines with no bid_line, plugs are a bid_line
// tagged source = plug.
model ScopeLineItem {
  id                String        @id @default(cuid())
  bidPackageId      String
  bidPackage        BidPackage    @relation(fields: [bidPackageId], references: [id], onDelete: Cascade)
  seq               Int
  csiCode           String?
  description       String
  unit              String?
  qty               Float?
  kind              ScopeLineKind
  isRequired        Boolean       @default(true)
  submittalRequired Boolean       @default(false)
  longLeadWeeks     Int?
  specSectionId     String?
  specSection       SpecSection?  @relation(fields: [specSectionId], references: [id])
  sourceDocumentId  String?
  sourcePage        Int?

  bidLines           BidLine[]
  lifecycleScenarios LifecycleScenario[]
}

// ── Bidding ──────────────────────────────────────────────────────

model Subcontractor {
  id             String    @id @default(cuid())
  name           String
  dba            String?
  ein            String?
  flLicense      String?
  trades         String[]
  // CSI division-level codes this sub bids (e.g. "07" Thermal & Moisture,
  // "09" Finishes) — distinct from `trades` (free-text labels). Lets a
  // work package's "Add bidders" search auto-filter to subs whose
  // csiCodes overlap the package's own BidPackage.csiCodes.
  csiCodes       String[]
  groups         String[]
  rating         Float?
  lastVerifiedAt DateTime?
  prequalJson    Json?
  notes          String?

  contacts       SubContact[]
  invitations    Invitation[]
  communications Communication[]
}

model SubContact {
  id              String        @id @default(cuid())
  subcontractorId String
  subcontractor   Subcontractor @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)
  name            String
  email           String?
  phone           String?
  isItbContact    Boolean       @default(false)
}

enum InvitationIntent {
  none
  bidding
  no_bid
}

model Invitation {
  id                String           @id @default(cuid())
  bidPackageId      String
  bidPackage        BidPackage       @relation(fields: [bidPackageId], references: [id], onDelete: Cascade)
  subcontractorId   String
  subcontractor     Subcontractor    @relation(fields: [subcontractorId], references: [id])
  token             String           @unique
  sentAt            DateTime?
  openedAt          DateTime?
  intent            InvitationIntent @default(none)
  feedbackRequested Boolean          @default(false)

  bids                    Bid[]
  rfis                    Rfi[]
  bondAlternateOnPackages BidPackage[] @relation("BondAlternateAccepted")

  @@unique([bidPackageId, subcontractorId])
}

enum BidSource {
  portal
  xlsx_upload
  manual
}

model Bid {
  id           String     @id @default(cuid())
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  submittedAt  DateTime?
  total        BigInt?
  addendaAcked String[]
  source       BidSource  @default(portal)
  attachments  String[]
  // Sub self-reported (or, eventually, parser-detected) that their bid
  // carries their own bond — surfaced only in the Bid Tab, never GC-facing
  // pages. Manual toggle today; a document parser is the real source later.
  bondIncluded Boolean    @default(false)

  bidLines BidLine[]
}

enum BidLineSource {
  sub
  parsed
  plug
  ours
}

model BidLine {
  id              String         @id @default(cuid())
  bidId           String
  bid             Bid            @relation(fields: [bidId], references: [id], onDelete: Cascade)
  scopeLineItemId String?
  scopeLineItem   ScopeLineItem? @relation(fields: [scopeLineItemId], references: [id])
  amount          BigInt
  unitPrice       BigInt?
  qty             Float?
  included        Boolean        @default(true)
  note            String?
  source          BidLineSource
  confidence      Float?
}

model Addendum {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number     Int
  issuedAt   DateTime @default(now())
  documentId String?
  scope      String   @default("all") // "all" or a trade/package scope key
  trades     String[]

  @@unique([projectId, number])
}

model Rfi {
  id               String      @id @default(cuid())
  projectId        String
  project          Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromInvitationId String?
  fromInvitation   Invitation? @relation(fields: [fromInvitationId], references: [id])
  body             String
  status           String      @default("open")
  routedTo         String?
  answer           String?
  answeredAt       DateTime?
  createdAt        DateTime    @default(now())
}

model Communication {
  id              String         @id @default(cuid())
  projectId       String
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subcontractorId String?
  subcontractor   Subcontractor? @relation(fields: [subcontractorId], references: [id])
  kind            String
  body            String
  at              DateTime       @default(now())
  author          String
}

// ── Money ────────────────────────────────────────────────────────

model BudgetLine {
  id             String      @id @default(cuid())
  projectId      String
  project        Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  bidPackageId   String?
  bidPackage     BidPackage? @relation(fields: [bidPackageId], references: [id])
  csiCode        String?
  description    String
  budget         BigInt
  current        BigInt
  buyoutExpected BigInt?
  awardedTo      String?
  note           String?
  tags           String[]

  lifecycleScenarios LifecycleScenario[]
  commitment         Commitment?
}

// Revisions store full JSONB snapshots, not diffs — comparison is computed
// at read time (STEP1_PLAN.md "Money").
model BudgetRevision {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revNo     Int
  snapshot  Json
  note      String?
  createdBy String
  createdAt DateTime @default(now())

  @@unique([projectId, revNo])
}

// Scenario-based lifecycle cost (D-43, closes Q-16). A baseline vs. one or
// more alternates for the same system — comparison is the point, not a
// flat one-row-per-system shape.
model LifecycleScenario {
  id                    String         @id @default(cuid())
  budgetLineId          String?
  budgetLine            BudgetLine?    @relation(fields: [budgetLineId], references: [id])
  scopeLineItemId       String?
  scopeLineItem         ScopeLineItem? @relation(fields: [scopeLineItemId], references: [id])
  label                 String
  isBaseline            Boolean        @default(true)
  initialCost           BigInt
  installYear           Int?
  serviceLifeYrs        Int
  replacementCost       BigInt?
  annualMaintenanceCost BigInt
  annualEnergyCost      BigInt
  energyEscalationRate  Float
  salvageValuePct       Float
  confidence            Float?
  sourceDocumentId      String?
  sourcePage            Int?
}

// Small global files the app itself owns (e.g. the bid bond template) —
// stored on the app service's persistent volume until SharePoint/OneDrive
// integration replaces this. Keyed by a fixed string so there's one row per
// purpose rather than a generic document library.
model AppFile {
  id          String   @id @default(cuid())
  key         String   @unique
  filename    String
  storagePath String
  mimeType    String?
  uploadedAt  DateTime @default(now())
}

// ── Settings — controlled vocabularies (E-05/E-06, D-41, Batch 6) ──────

enum FlagType {
  requirement
  informational
  risk
}

model Flag {
  id            String   @id @default(cuid())
  label         String   @unique
  type          FlagType
  description   String?
  parseKeywords String[]
  // "allow customization of tag and add glyph" (S-batch #52) — color
  // overrides the type-derived chip style when set (one of the existing
  // chip variant suffixes: dgr/info/risk/ok/acc); glyph is a short
  // emoji/character shown in the chip. Both optional — null falls back
  // to the type-derived default.
  color         String?
  glyph         String?

  projectFlags ProjectFlag[]
}

model ProjectFlag {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  flagId    String
  flag      Flag    @relation(fields: [flagId], references: [id])

  @@unique([projectId, flagId])
}

model Trade {
  id      String  @id @default(cuid())
  name    String  @unique
  csiCode String?
}

// "sort tags by types and group by types [location tags, requirement
// tags, project types, contract type, special tags]" (S-batch #54).
enum TagType {
  location
  requirement
  project_type
  contract_type
  special
}

model Tag {
  id   String  @id @default(cuid())
  name String  @unique
  type TagType @default(special)

  projectTags ProjectTag[]
}

model ProjectTag {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id])

  @@unique([projectId, tagId])
}

// Settings "Bid Packages" builder (S-batch #53) — drag CSI codes from the
// left-pane master list into a package on the right (or arrow-click one
// in as a new single-item package) to build a reusable code-to-package
// grouping, e.g. one "Roofing" package pulling together TPO, metal panel,
// and insulation CSI sections. `division` is the CSI division selected
// when the package is created; purely descriptive, not enforced against
// its csiCodes' own divisions.
model PackageTemplate {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  division     String?
  csiCodes     String[]
  defaultFlags String[]

  bidPackages BidPackage[]
}

// ── Auth (S-batch: interim Credentials login, Auth.js/next-auth v5) ──
// Standard Auth.js Prisma-adapter shape (Account/Session/VerificationToken)
// so an OAuth provider (MS/Azure AD, per the owner's stated plan) can be
// added later without a schema change — Credentials auth itself only
// touches User, and uses the "jwt" session strategy, so Session rows
// aren't populated today.
enum UserRole {
  admin
  estimator
  manager
  director
  owner
  field
  project_manager
  superintendent
  preconstruction_viewer
}

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  passwordHash           String?
  name                   String
  image                  String?
  role                   UserRole  @default(estimator)
  phone                  String?
  emailSignature         String?
  // Dashboard status-filter chip selection (S-batch #71) — "remember what
  // i last had selected" per user, not per browser session.
  dashboardStatusFilters String[]  @default([])
  emailVerified          DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  seenItems SeenItem[]
}

// Generic "seen by this user" marker (S-batch #66) — "stored as user not
// browser session" so a glyph disappears for good once a user has viewed
// an item, on any device. entityType is a free-form tag ("hot_item" today;
// budget items/plugs/awards/files/addenda are the same mechanism, added as
// those surfaces pick it up) rather than a relation per type, so one table
// covers every future entity without a schema change each time.
model SeenItem {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String
  seenAt     DateTime @default(now())

  @@unique([userId, entityType, entityId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

